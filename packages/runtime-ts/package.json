{
  "name": "@nanobot/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:events": "tsc -p tsconfig.events.json",
    "build:native": "node-gyp rebuild --directory native",
    "prepare": "npm run build:native"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nunjucks": "3.2.6",
    "node-gyp": "12.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jsonrepair": "3.15.0",
    "nunjucks": "3.2.4",
    "sqlite3": "6.0.1",
    "yaml": "2.9.1"
  }
}
